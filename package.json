    "devDependencies": {
        "@types/bun": "^1.4.3",
        "@types/react": "~19.2.2",
        "@types/three": "^0.186.0",
        "eslint": "^9.0.0",
        "eslint-config-expo": "~57.0.2",
        "typescript": "~6.0.3"
    },
    "scripts": {
        "start": "expo start",
        "android": "expo start --android",
        "ios": "expo start --ios",
        "web": "expo start --web",
        "lint": "expo lint",
        "dev": "bun run scripts/dev.ts",
        "server": "bun run server/index.ts",
        "build:apk-local": "JAVA_HOME=/usr/lib/jvm/java-17-openjdk ANDROID_HOME=$HOME/Android/Sdk bunx eas-cli build --platform android --profile preview --local --output family-games.apk",
        "build:apk-windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-apk-windows.ps1",
        "test:server": "BOT_SPEED=0.05 bun test server",
        "typecheck": "tsc --noEmit && tsc -p server/tsconfig.json",
        "update": "eas update --channel preview --platform android",
        "update:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/publish-update-windows.ps1"
    },
    "private": true
}
